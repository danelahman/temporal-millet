(* Run this example with the 'timed-traces-interval' grading monoid, e.g.

     ./cli.exe --resources timed-traces-interval examples/timed_traces_interval.mlt *)

type model = Model of string
type heated = Heated of model
type extruded = Extruded of heated
type cooled = Cooled of extruded
type fresh = Fresh of cooled | Reheated of heated

(* The heater warms a model up, so that it can be extruded. *)
operation Heat : model ~> heated # ({Heat}, {Heat}) within (1, 2)
default Heat m = delay 1; Heated m

(* A freshly extruded model is still hot: it may be handed to the cooler, but
   not touched otherwise until it has rested for two ticks. *)
operation Extrude : heated ~> [2] extruded
  # ({Extrude}, {Extrude})
  within (3, 5)
default Extrude h = delay 3; box 2 (Extruded h)

(* The cooler takes the hot extruded model, once it has rested, and cools it
   down to something that can be handled. *)
operation Cool : [2] extruded ~> cooled # ({Cool}, {Cool}) within (2, 2)
default Cool p = delay 2; unbox p as e in Cooled e

(* A print is the three steps, in that order, on both sides of the pair. The
   finished print has to set for two ticks and be collected within eight. *)
operation PrintModel : model ~> [(2, 8)] fresh
  # ({Heat; Extrude; Cool}, {Heat; Extrude; Cool})
  within (6, 9)

(* A print job either extrudes a fresh model or is a quick reheat, again on both
   sides of the pair. *)
operation Print : model ~> [(2, 8)] fresh
  # ({Heat; Extrude; Cool | Heat; Cool}, {Heat; Extrude; Cool | Heat; Cool})
  within (3, 9)

(* An asymmetric job: the lower bound guarantees at least a reheat, while the
   upper bound allows a full print. *)
operation Print2 : model ~> [(2, 8)] fresh
  # ({Heat; Cool}, {Heat; Extrude; Cool | Heat; Cool})
  within (3, 9)

(* A single transmission of a message. *)
operation Tx : string ~> unit # ({Tx}, {Tx}) within (2, 3)
default Tx msg = delay 2

(* A send is one or two transmissions, on both sides of the pair. *)
operation Send : string ~> unit # ({Tx | Tx; Tx}, {Tx | Tx; Tx}) within (2, 6)

(* Correctly accepted by the typechecker: heating and extruding banks 1 + 3
   ticks towards the lower bound of the box, which demands three, and costs at
   most 2 + 5 ticks of its upper bound, which allows seven. *)
let make_cog () =
  box (3, 7) (Model "Cog") as blueprint in
  let h = perform Heat (Model "Cog") in
  let p = perform Extrude h in
  unbox blueprint as m in
  let c = perform Cool p in
  (m, Fresh c)

(* Correctly accepted by the typechecker: the same bound spelled out with the
   two events on each side of the pair instead of as a time interval. *)
let make_gear () =
  box ({Heat; Extrude}, {Heat; Extrude}) (Model "Gear") as blueprint in
  let h = perform Heat (Model "Gear") in
  let p = perform Extrude h in
  unbox blueprint as m in
  let c = perform Cool p in
  (m, Fresh c)

(* Correctly accepted by the typechecker by sub-effecting: a clause may forward
   the operation it handles, since '({Heat}, {Heat})' is a sub-grade of itself
   composed with the grade of the continuation. *)
let forward =
  handler
  | x -> x
  | Heat m k -> let h = perform Heat m in continue k with h

(* Correctly accepted by the typechecker: the clause performs exactly the three
   steps 'PrintModel' promises, in the promised order, which covers the lower
   bound and fits inside the upper bound. *)
let printer =
  handler
  | x -> x
  | PrintModel m k ->
      let h = perform Heat m in
      let p = perform Extrude h in
      let c = perform Cool p in
      continue k with (box (2, 8) (Fresh c))

(* Correctly accepted by the typechecker: a whole 'PrintModel' banks the six
   ticks the lower bound of the box demands, because 1 + 3 + 2 = 6, and costs
   at most the nine the upper bound allows, because 2 + 5 + 2 = 9 --- both
   endpoints exact. The closing wait then collects the print: it banks the two
   ticks the '[(2, 8)]' box demands, well inside the eight it allows. *)
let print_sword () =
  handle
    box (6, 9) (Model "Sword") as blueprint in
    let printed = perform PrintModel (Model "Sword") in
    unbox blueprint as m in
    delay 2;
    unbox printed as p in
    (m, p)
  with printer

(* Correctly accepted by the typechecker: the same bound spelled out with the
   three events on each side of the pair instead of as a time interval. *)
let print_cog () =
  handle
    box ({Heat; Extrude; Cool}, {Heat; Extrude; Cool})
        (Model "Cog") as blueprint in
    let printed = perform PrintModel (Model "Cog") in
    unbox blueprint as m in
    delay 2;
    unbox printed as p in
    (m, p)
  with printer

(* Correctly accepted by the typechecker: the clause realises the first of the
   two runs 'Print' allows, covering it on the lower bound and fitting inside
   it on the upper bound. *)
let full_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      let p = perform Extrude h in
      let c = perform Cool p in
      continue k with (box (2, 8) (Fresh c))

(* Correctly accepted by the typechecker: the clause realises the other run, a
   reheat that skips the extrusion --- the model was extruded in an earlier
   job, so it goes straight from the heater to the cooler. *)
let quick_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      perform Cool (box 2 (Extruded h));
      continue k with (box (2, 8) (Reheated h))

(* Correctly accepted by the typechecker: a reheat is exactly what the lower
   bound of 'Print2' guarantees, and it fits inside the second run of its
   upper bound. *)
let reheater =
  handler
  | x -> x
  | Print2 m k ->
      let h = perform Heat m in
      perform Cool (box 2 (Extruded h));
      continue k with (box (2, 8) (Reheated h))

(* Correctly accepted by the typechecker: the upper bound of 'Print2' also
   allows a full print, and the extrusion in the middle does not stop the
   clause from covering the reheat the lower bound demands. *)
let deluxe_printer =
  handler
  | x -> x
  | Print2 m k ->
      let h = perform Heat m in
      let p = perform Extrude h in
      let c = perform Cool p in
      continue k with (box (2, 8) (Fresh c))

(* Correctly accepted by the typechecker: transmitting once covers the first
   trace of the lower bound and fits inside the first trace of the upper
   bound. *)
let send_once =
  handler
  | x -> x
  | Send msg k -> perform Tx msg; continue k with ()

(* Correctly accepted by the typechecker: the retry likewise covers and fits
   inside the two-transmission trace on either side of the pair. *)
let send_retry =
  handler
  | x -> x
  | Send msg k -> perform Tx msg; perform Tx msg; continue k with ()

(* Correctly accepted by the typechecker: a single transmission banks at least
   the two ticks the lower bound demands, and a retried one costs at most the
   six ticks the upper bound allows. *)
let send_telemetry () =
  handle
    box (2, 6) "ack" as slot in
    perform Send "telemetry";
    unbox slot as a in
    a
  with send_retry

(* Correctly accepted by the typechecker: a non-exact bound on both sides ---
   the lower bound demands only the first transmission, and the upper bound
   allows either two transmissions or six ticks of waiting. *)
let send_by_events () =
  box ({Tx}, {Tx; Tx | 6}) "ack" as slot in
  perform Send "telemetry";
  unbox slot as a in
  a

(* Correctly rejected by the typechecker: the order of the events is part of
   both sides of the pair, and this clause sends the model to the cooler before
   it has been through the extruder. The types alone no longer allow a print to
   be run backwards, so only the grade can catch this:

     Typing error: Comparing resource inequality
       ({Heat; Cool; Extrude},{Heat; Cool; Extrude})
       <= ({Heat; Extrude; Cool},{Heat; Extrude; Cool}) failed
*)
(*
let early_cooler =
  handler
  | x -> x
  | PrintModel m k ->
      let h = perform Heat m in
      perform Cool (box 2 (Extruded h));
      perform Extrude h;
      continue k with (box (2, 8) (Reheated h))
*)

(* Correctly rejected by the typechecker: neither run of 'Print' begins with a
   'Cool', and the order of a bound is not negotiable, however the model that
   is handed to the cooler came to be:

     Typing error: Comparing resource inequality
       ({Cool; Heat},{Cool; Heat})
       <= ({Heat; Cool | Heat; Extrude; Cool},
           {Heat; Cool | Heat; Extrude; Cool}) failed
*)
(*
let twisted_printer =
  handler
  | x -> x
  | Print m k ->
      perform Cool (box 2 (Extruded (Heated m)));
      let h = perform Heat m in
      continue k with (box (2, 8) (Reheated h))
*)

(* Correctly rejected by the typechecker on the lower bound, which demands the
   whole run it promises: a clause that stops after the extrusion covers
   neither run of 'Print', even though the upper bound of 'Print' would
   happily allow it:

     Typing error: Comparing resource inequality
       ({Heat; Extrude},{Heat; Extrude})
       <= ({Heat; Cool | Heat; Extrude; Cool},
           {Heat; Cool | Heat; Extrude; Cool}) failed
*)
(*
let sloppy_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      perform Extrude h;
      continue k with (box (2, 8) (Reheated h))
*)

(* Correctly rejected by the typechecker on the lower bound, whose seven ticks
   are not banked by a print, which banks only 1 + 3 + 2:

     Typing error: Comparing resource inequality
       ({Heat; Extrude; Cool},{Heat; Extrude; Cool})
       <= ({7},{9}) failed
*)
