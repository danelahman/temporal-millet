  handle
    box (4, 6) "ack" as slot in
    perform Send "telemetry";
    unbox slot as a in
    a
  with send_retry
*)

(* The single run below handles the 'PrintModel' with 'printer', which replaces
   it by the three steps of a print. Those are atomic, and the defaults given
   for them above say what they mean, so the run completes and returns the
   printed sword together with the blueprint it was made from. *)
run print_sword ()
