(* Correctly accepted by the typechecker, under 'traces-upper-bound': the
   annotation allows a single transmission or a retry, and the body transmits
   once, which fits inside either run. *)
operation Tx : string ~> unit # {Tx} within (2, 3)
default Tx msg = delay 2

let send msg : unit # {Tx | Tx; Tx} = perform Tx msg

run send "ping"
