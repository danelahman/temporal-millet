(* Run this test with the 'time-upper-bound' grading monoid, e.g.

     ./temporal-millet --resources time-upper-bound tests/eternal_tyvars_reject_handler.mlt *)

operation Op : unit ~> unit # 1

(* An operation case keeps only eternal types from outside it, so x must be
   eternal: h gets the type {eternal α} α → (α # ρ₀ ⇒ α # ρ₁). *)
let h x = handler | y -> y | Op p k -> let r = continue k with () in x

(* Correctly rejected by the typechecker: a function is never eternal. *)
run handle (perform Op (); (fun () -> ())) with h (fun () -> ())
