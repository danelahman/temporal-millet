(* Run this test with the default 'time-lower-bound' grading monoid, e.g.

     ./temporal-millet tests/continuation_discard_reject_lower.mlt *)

operation Op : unit ~> unit # 1

(* As 'continuation_discard_upper.mlt', but under a lower bound 0 is the top
   of the order, so 0 >= 1 + rho fails already for rho = 0. *)
let h = handler | x -> x | Op p k -> 5

(* Correctly rejected by the typechecker:

     Typing error: Comparing resource inequality 0 >= ρ₀ + 1 failed, already
       when the continuation grade is 0
*)
run handle (perform Op (); delay 5; 3) with h
