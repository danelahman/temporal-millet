(* Run this test with the 'time-upper-bound' grading monoid, e.g.

     ./temporal-millet --resources time-upper-bound tests/continuation_nested_escape_reject.mlt *)

operation Op1 : unit ~> unit # 1
operation Op2 : unit ~> unit # 1

(* Correctly rejected by the typechecker: g is bound outside the case for Op1,
   whose context keeps nothing but eternal types, and a function is never
   eternal. Were g admitted, the grade of the inner continuation k' would
   escape into the type of h through it, which the rigid-escape check catches
   as a safety net. *)
let h g =
  handler
  | x -> x
  | Op1 p k ->
      handle
        perform Op2 ();
        continue k with ()
      with
        (handler
         | y -> y
         | Op2 q k' -> g k'; delay 1; continue k' with ())

run handle (perform Op1 (); 7) with h (fun k' -> return ())
