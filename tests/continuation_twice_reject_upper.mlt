(* Run this test with the 'time-upper-bound' grading monoid, e.g.

     ./temporal-millet --resources time-upper-bound tests/continuation_twice_reject_upper.mlt *)

operation Op : unit ~> unit # 1

(* Correctly rejected by the typechecker: resuming twice gives the case grade
   rho + rho, which is not a sub-grade of 1 + rho for every rho: it fails
   already for rho = 2. *)
let h = handler | x -> x | Op p k -> let a = continue k with () in continue k with ()

run handle (perform Op (); 3) with h
