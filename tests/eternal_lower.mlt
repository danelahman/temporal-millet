(* The definitions of 'eternal_tyvars.mlt' under the default
   'time-lower-bound' grading monoid, where zero is the top of the sub-grade
   order. There the inequality accompanying every eternality constraint holds
   outright, so the generalised types carry no constraints and a function may
   be kept across a delay. *)

let keep x = delay 1; x
let after g x = g (); x

(* Correctly accepted by the typechecker under this monoid. *)
run keep (fun () -> ())
run after (fun () -> delay 2) (fun () -> ())
