(* Correctly rejected by the typechecker, under the 'timed-traces-upper-bound'
   grading monoid: the events of a grade must be operations that have already
   been declared, or the operation being declared. *)

operation Heat : unit ~> unit # {Heat} within (1, 2)
operation PrintModel : unit ~> unit # {Heat; Extrude} within (6, 9)
