(* Correctly rejected by the typechecker, under the 'traces-upper-bound'
   grading monoid: only an atomic operation may be given a default
   implementation. A compound operation names the operations it decomposes
   into, and is to be given meaning by a handler in terms of them. *)

type model = Model of string
type fresh = Fresh of model

operation Heat : unit ~> unit # {Heat} within (1, 2)
operation Extrude : unit ~> unit # {Extrude} within (3, 5)
operation Cool : unit ~> unit # {Cool} within (2, 2)
operation PrintModel : model ~> fresh # {Heat; Extrude; Cool} within (6, 9)

default PrintModel m = delay 6; Fresh m
