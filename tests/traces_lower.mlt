(* Run this example with the 'traces-lower-bound' grading monoid, e.g.

     ./cli.exe --resources traces-lower-bound examples/traces_lower.mlt *)

type model = Model of string
type heated = Heated of model
type extruded = Extruded of heated
type cooled = Cooled of extruded
type fresh = Fresh of cooled | Reheated of heated
(* Mixed epoxy does not keep: 'noneternal' annotation means the glue has to be
   used in the very step in which it is unboxed. *)
noneternal type epoxy = Epoxy

(* Mounting uses the glue up, so a mounted print holds no epoxy and is
   structurally eternal again. *)
type mounted = Mounted of fresh
type receipt = Receipt of string

(* The heater warms a model up, so that it can be extruded. *)
operation Heat : model ~> heated # {Heat} within (1, 2)
default Heat m = delay 1; Heated m

(* A freshly extruded model is still hot: it may be handed to the cooler, but
   not touched otherwise until it has rested for two ticks. *)
operation Extrude : heated ~> [2] extruded # {Extrude} within (3, 5)
default Extrude h = delay 3; box 2 (Extruded h)

(* The cooler takes the hot extruded model, once it has rested, and cools it
   down to something that can be handled. *)
operation Cool : [2] extruded ~> cooled # {Cool} within (2, 2)
default Cool p = delay 2; unbox p as e in Cooled e

(* Mounting glues a finished print onto its base; the glue is used up. *)
operation Mount : fresh * epoxy ~> mounted # {Mount} within (1, 1)
default Mount (p, g) = delay 1; Mounted p

(* Mixing two-part epoxy takes a tick; the mix then needs eight ticks to set. *)
operation MixEpoxy : unit ~> [8] epoxy # {MixEpoxy} within (1, 1)
default MixEpoxy () = delay 1; box 8 Epoxy

(* A quick-setting epoxy for small parts. *)
operation MixQuickEpoxy : unit ~> [3] epoxy # {MixQuickEpoxy} within (1, 1)
default MixQuickEpoxy () = delay 1; box 3 Epoxy

(* A print is the three steps, in that order, and the finished print has to set
   for two ticks before it may be collected. *)
operation PrintModel : model ~> [2] fresh # {Heat; Extrude; Cool} within (6, 9)

(* A print job either extrudes a fresh model or is a quick reheat. *)
operation Print : model ~> [2] fresh
  # {Heat; Extrude; Cool | Heat; Cool}
  within (3, 9)

(* A single transmission of a message. *)
operation Tx : string ~> unit # {Tx} within (2, 3)
default Tx msg = delay 2

(* A delivery is one or two transmissions. *)
operation Deliver : string ~> unit # {Tx | Tx; Tx} within (2, 6)

(* Correctly accepted by the typechecker: running 'Extrude' banks the lower end
   of its runtime bounds, three ticks, which covers the three ticks the epoxy
   of 'MixQuickEpoxy' needs to set --- the boxing is done by the default
   implementation of that operation, not by hand. *)
let extrude_layer h =
  let glue = perform MixQuickEpoxy () in
  let p = perform Extrude h in
  unbox glue as g in
  (g, p)

(* Correctly accepted by the typechecker: the clause performs exactly the three
   steps 'PrintModel' promises, in the promised order. *)
let printer =
  handler
  | x -> x
  | PrintModel m k ->
      let h = perform Heat m in
      let p = perform Extrude h in
      let c = perform Cool p in
      continue k with (box 2 (Fresh c))

(* Correctly accepted by the typechecker: the rest banks the two ticks the
   print's '[2]' box demands, and the print plus the rest bank exactly the
   eight the epoxy needs to set (1 + 3 + 2 + 2). Zero is the top of this
   monoid's order, so the 'noneternal' declaration has no effect here. *)
let print_sword () =
  handle
    let glue = perform MixEpoxy () in
    let printed = perform PrintModel (Model "Sword") in
    delay 2;
    unbox printed as p in
    unbox glue as g in
    perform Mount (p, g)
  with printer

(* Correctly accepted by the typechecker: the same demand covered by hand,
   without the handler --- the three steps and the closing rest bank the
   1 + 3 + 2 + 2 = 8 ticks the epoxy of 'MixEpoxy' asks for. *)
let print_cog () =
  let glue = perform MixEpoxy () in
  let h = perform Heat (Model "Cog") in
  let p = perform Extrude h in
  let c = perform Cool p in
  delay 2;
  unbox glue as g in
  perform Mount (Fresh c, g)

(* Correctly accepted by the typechecker: the clause covers the first of the two
   runs 'Print' promises. *)
let full_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      let p = perform Extrude h in
      let c = perform Cool p in
      continue k with (box 2 (Fresh c))

(* Correctly accepted by the typechecker: the clause covers the other run, a
   reheat that skips the extrusion --- the model was extruded in an earlier
   job, so it goes straight from the heater to the cooler. *)
let quick_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      perform Cool (box 2 (Extruded h));
      continue k with (box 2 (Reheated h))

(* Correctly accepted by the typechecker, which may be surprising: a lower
   bound only demands a minimum, so a clause may cool a second time on top of
   the full print it covers. *)
let thorough_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      let p = perform Extrude h in
      let c = perform Cool p in
      perform Cool (box 2 (Extruded h));
      continue k with (box 2 (Fresh c))

(* Correctly accepted by the typechecker for the same reason: a full print
   followed by a tick of waiting still covers the run it realises. *)
let slow_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      let p = perform Extrude h in
      let c = perform Cool p in
      delay 1;
      continue k with (box 2 (Fresh c))

(* Correctly accepted by the typechecker: the clause transmits once, which
   covers the first trace 'Deliver' promises. *)
let deliver_once =
  handler
  | x -> x
  | Deliver msg k -> perform Tx msg; continue k with ()

(* Correctly accepted by the typechecker: transmitting twice covers the other
   trace 'Deliver' promises --- a genuine retry. *)
let deliver_retry =
  handler
  | x -> x
  | Deliver msg k -> perform Tx msg; perform Tx msg; continue k with ()

(* Correctly accepted by the typechecker, which may be surprising: a lower
   bound only demands a minimum, so a clause may transmit a third time on top
   of the two-transmission trace it covers. *)
let deliver_thrice =
  handler
  | x -> x
  | Deliver msg k ->
      perform Tx msg;
      perform Tx msg;
      perform Tx msg;
      continue k with ()

(* Correctly accepted by the typechecker for the same reason: a transmission
   followed by a tick of waiting still covers the one-transmission trace. *)
let deliver_slow =
  handler
  | x -> x
  | Deliver msg k -> perform Tx msg; delay 1; continue k with ()

(* Correctly accepted by the typechecker: whichever way the retrying handler
   delivers, at least two ticks --- the lower end of the bounds of 'Tx' --- have
   been banked by the time the receipt is read. *)
let deliver_ping () =
  handle
    box 2 (Receipt "ping") as slot in
    perform Deliver "ping";
    unbox slot as r in
    r
  with deliver_retry

(* Correctly accepted by the typechecker: the same demand spelled out as an
   event instead of as ticks --- both traces of 'Deliver' begin with a 'Tx',
   so the receipt is ready as soon as one has gone out. *)
let deliver_by_events () =
  box {Tx} (Receipt "ping") as slot in
  perform Deliver "ping";
  unbox slot as r in
  r

(* Correctly rejected by the typechecker: the order of the events is part of the
   demand, and this clause sends the model to the cooler before it has been
   through the extruder. The types alone no longer allow a print to be run
   backwards, so only the grade can catch this:

     Typing error: Comparing resource inequality {Heat; Cool; Extrude}
       <= {Heat; Extrude; Cool} failed
*)
(*
let early_cooler =
  handler
  | x -> x
  | PrintModel m k ->
      let h = perform Heat m in
      perform Cool (box 2 (Extruded h));
      perform Extrude h;
      continue k with (box 2 (Reheated h))
*)

(* Correctly rejected by the typechecker: neither run of 'Print' begins with a
   'Cool', and the order of a demand is not negotiable, however the model that
   is handed to the cooler came to be:

     Typing error: Comparing resource inequality {Cool; Heat}
       <= {Heat; Cool | Heat; Extrude; Cool} failed
*)
(*
let twisted_printer =
  handler
  | x -> x
  | Print m k ->
      perform Cool (box 2 (Extruded (Heated m)));
      let h = perform Heat m in
      continue k with (box 2 (Reheated h))
*)

(* Correctly rejected by the typechecker: a clause that stops after the
   extrusion covers neither run of 'Print', since a lower bound demands the
   whole run it promises. This is the mirror image of the upper-bound file,
   where the very same clause is accepted, because an upper bound only forbids
   doing more:

     Typing error: Comparing resource inequality {Heat; Extrude}
       <= {Heat; Cool | Heat; Extrude; Cool} failed
*)
(*
let sloppy_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      perform Extrude h;
      continue k with (box 2 (Reheated h))
*)

(* Correctly rejected by the typechecker, and the reason the mixing has to be a
   default implementation rather than a handler: an operation case is checked
   against the grade of the operation, and waiting never realises the demanded
   event '{MixEpoxy}' --- only performing 'MixEpoxy' itself would, which is
   circular. A default is checked against the 'within (1, 1)' bounds instead,
   which the very same tick of mixing meets exactly:

     Typing error: Comparing resource inequality {1} <= {MixEpoxy} failed
*)
(*
let mixer =
  handler
  | x -> x
  | MixEpoxy () k -> delay 1; continue k with (box 8 Epoxy)
*)

(* Correctly rejected by the typechecker: the epoxy is mixed after the print
   instead of before it, so only the two ticks of the closing rest are banked
   towards the eight it needs to set:

     Typing error: Comparing resource inequality {2} <= {8} failed
*)
(*
let print_sword_eager () =
  handle
    let printed = perform PrintModel (Model "Sword") in
    let glue = perform MixEpoxy () in
    delay 2;
    unbox printed as p in
    unbox glue as g in
    perform Mount (p, g)
  with printer
*)

(* Correctly rejected by the typechecker: waiting is never a way of performing a
   demanded operation, so a clause that only delays cannot realise the
   transmission 'Deliver' promises, no matter how long it waits:

     Typing error: Comparing resource inequality {6} <= {Tx | Tx; Tx} failed
*)
(*
let deliver_stall =
  handler
  | x -> x
  | Deliver msg k -> delay 6; continue k with ()
*)

(* Correctly rejected by the typechecker: a clause that drops the message
   altogether banks nothing towards the transmission 'Deliver' promises:

     Typing error: Comparing resource inequality {0} <= {Tx | Tx; Tx} failed
*)
(*
let deliver_drop =
  handler
  | x -> x
  | Deliver msg k -> continue k with ()
*)

(* Correctly rejected by the typechecker: the quick epoxy is mixed only after
   the extrusion, so the three ticks the extruder banks are spent before the
   glue exists, and nothing at all is banked towards the three it needs to set:

     Typing error: Comparing resource inequality {0} <= {3} failed
*)
(*
let extrude_layer_slow h =
  let p = perform Extrude h in
  let glue = perform MixQuickEpoxy () in
  unbox glue as g in
  (g, p)
*)

(* Correctly rejected by the typechecker: a delivery may consist of a single
   transmission, which banks only two ticks, not the four the receipt
   demands:

     Typing error: Comparing resource inequality {Tx | Tx; Tx} <= {4} failed
*)
(*
let deliver_ping_eager () =
  handle
    box 4 (Receipt "ping") as slot in
    perform Deliver "ping";
    unbox slot as r in
    r
  with deliver_retry
*)

(* Correctly rejected by the typechecker: one 'Deliver' does not guarantee two
   transmissions, so it does not cover a demand for two:

     Typing error: Comparing resource inequality {Tx | Tx; Tx}
       <= {Tx; Tx} failed
*)
(*
let deliver_by_two () =
  box {Tx; Tx} (Receipt "ping") as slot in
  perform Deliver "ping";
  unbox slot as r in
  r
*)

(* 'printer' handles 'PrintModel'; the atomic 'MixEpoxy', 'Heat', 'Extrude',
   'Cool' and 'Mount' reach the top level and run their defaults, so the run
   completes with the sword mounted on its base. *)
run print_sword ()
