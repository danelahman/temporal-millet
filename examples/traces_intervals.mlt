  let c = perform Cool p in
  perform Mount (Fresh c, g)
*)

(* Correctly rejected by the typechecker: the quick epoxy is mixed only after
   the extrusion, so nothing at all is banked towards the three ticks it needs
   to set by the time it is unboxed:

     Typing error: Comparing resource inequality ({0},{0}) <= ({3},{7}) failed
*)
(*
