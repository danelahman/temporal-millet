(* Run this example with the 'traces-interval' grading monoid, e.g.

     ./cli.exe --resources traces-interval examples/traces_intervals.mlt *)

type model = Model of string
type heated = Heated of model
type extruded = Extruded of heated
type cooled = Cooled of extruded
type fresh = Fresh of cooled | Reheated of heated
(* Mixed epoxy does not keep: 'noneternal' annotation means the glue has to be
   used in the very step in which it is unboxed. *)
noneternal type epoxy = Epoxy

(* Mounting uses the glue up, so a mounted print holds no epoxy and is
   structurally eternal again. *)
type mounted = Mounted of fresh
type receipt = Receipt of string

(* The heater warms a model up, so that it can be extruded. *)
operation Heat : model ~> heated # ({Heat}, {Heat}) within (1, 2)
default Heat m = delay 1; Heated m

(* A freshly extruded model is still hot: it may be handed to the cooler, but
   not touched otherwise until it has rested for two ticks. *)
operation Extrude : heated ~> [2] extruded
  # ({Extrude}, {Extrude})
  within (3, 5)
default Extrude h = delay 3; box 2 (Extruded h)

(* The cooler takes the hot extruded model, once it has rested, and cools it
   down to something that can be handled. *)
operation Cool : [2] extruded ~> cooled # ({Cool}, {Cool}) within (2, 2)
default Cool p = delay 2; unbox p as e in Cooled e

(* Mounting glues a finished print onto its base; the glue is used up. *)
operation Mount : fresh * epoxy ~> mounted # ({Mount}, {Mount}) within (1, 1)
default Mount (p, g) = delay 1; Mounted p

(* Mixing two-part epoxy takes a tick; the mix then needs eight ticks to set,
   and it has hardened after eleven. *)
operation MixEpoxy : unit ~> [(8, 11)] epoxy
  # ({MixEpoxy}, {MixEpoxy})
  within (1, 1)
default MixEpoxy () = delay 1; box (8, 11) Epoxy

(* A quick-setting epoxy for small parts. *)
operation MixQuickEpoxy : unit ~> [(3, 7)] epoxy
  # ({MixQuickEpoxy}, {MixQuickEpoxy})
  within (1, 1)
default MixQuickEpoxy () = delay 1; box (3, 7) Epoxy

(* A print is the three steps, in that order, on both sides of the pair. The
   finished print has to set for two ticks and be collected within eight. *)
operation PrintModel : model ~> [(2, 8)] fresh
  # ({Heat; Extrude; Cool}, {Heat; Extrude; Cool})
  within (6, 9)

(* A print job either extrudes a fresh model or is a quick reheat, again on both
   sides of the pair. *)
operation Print : model ~> [(2, 8)] fresh
  # ({Heat; Extrude; Cool | Heat; Cool}, {Heat; Extrude; Cool | Heat; Cool})
  within (3, 9)

(* An asymmetric job: the lower bound guarantees at least a reheat, while the
   upper bound allows a full print. *)
operation Print2 : model ~> [(2, 8)] fresh
  # ({Heat; Cool}, {Heat; Extrude; Cool | Heat; Cool})
  within (3, 9)

(* A single transmission of a message. *)
operation Tx : string ~> unit # ({Tx}, {Tx}) within (2, 3)
default Tx msg = delay 2

(* A send is one or two transmissions, on both sides of the pair. *)
operation Send : string ~> unit # ({Tx | Tx; Tx}, {Tx | Tx; Tx}) within (2, 6)

(* Correctly accepted by the typechecker: the clause performs exactly the three
   steps 'PrintModel' promises, in the promised order, which covers the lower
   bound and fits inside the upper bound. *)
let printer =
  handler
  | x -> x
  | PrintModel m k ->
      let h = perform Heat m in
      let p = perform Extrude h in
      let c = perform Cool p in
      continue k with (box (2, 8) (Fresh c))

(* Correctly accepted by the typechecker: the rest banks the two ticks the
   print's '[(2, 8)]' box demands, and the print plus the rest bank exactly
   the eight the epoxy needs to set (1 + 3 + 2 + 2) while staying within its
   pot life of eleven (2 + 5 + 2 + 2). *)
let print_sword () =
  handle
    let glue = perform MixEpoxy () in
    let printed = perform PrintModel (Model "Sword") in
    delay 2;
    unbox printed as p in
    unbox glue as g in
    perform Mount (p, g)
  with printer

(* Correctly accepted by the typechecker: the same window realised by hand,
   without the handler --- the three steps and the closing rest bank
   1 + 3 + 2 + 2 = 8 on the lower bound and 2 + 5 + 2 + 2 = 11 on the upper,
   which is exactly what the epoxy of 'MixEpoxy' asks for. *)
let print_cog () =
  let glue = perform MixEpoxy () in
  let h = perform Heat (Model "Cog") in
  let p = perform Extrude h in
  let c = perform Cool p in
  delay 2;
  unbox glue as g in
  perform Mount (Fresh c, g)

(* Correctly accepted by the typechecker: the clause realises the first of the
   two runs 'Print' allows, covering it on the lower bound and fitting inside
   it on the upper bound. *)
let full_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      let p = perform Extrude h in
      let c = perform Cool p in
      continue k with (box (2, 8) (Fresh c))

(* Correctly accepted by the typechecker: the clause realises the other run, a
   reheat that skips the extrusion --- the model was extruded in an earlier
   job, so it goes straight from the heater to the cooler. *)
let quick_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      perform Cool (box 2 (Extruded h));
      continue k with (box (2, 8) (Reheated h))

(* Correctly accepted by the typechecker: a reheat is exactly what the lower
   bound of 'Print2' guarantees, and it fits inside the second run of its
   upper bound. *)
let reheater =
  handler
  | x -> x
  | Print2 m k ->
      let h = perform Heat m in
      perform Cool (box 2 (Extruded h));
      continue k with (box (2, 8) (Reheated h))

(* Correctly accepted by the typechecker: the upper bound of 'Print2' also
   allows a full print, and the extrusion in the middle does not stop the
   clause from covering the reheat the lower bound demands. *)
let deluxe_printer =
  handler
  | x -> x
  | Print2 m k ->
      let h = perform Heat m in
      let p = perform Extrude h in
      let c = perform Cool p in
      continue k with (box (2, 8) (Fresh c))

(* Correctly accepted by the typechecker: transmitting once covers the first
   trace of the lower bound and fits inside the first trace of the upper
   bound. *)
let send_once =
  handler
  | x -> x
  | Send msg k -> perform Tx msg; continue k with ()

(* Correctly accepted by the typechecker: the retry likewise covers and fits
   inside the two-transmission trace on either side of the pair. *)
let send_retry =
  handler
  | x -> x
  | Send msg k -> perform Tx msg; perform Tx msg; continue k with ()

(* Correctly accepted by the typechecker: the receipt may be read only once a
   transmission has gone out, which banks at least the two ticks the lower
   bound demands, and the session expires after the six ticks of the upper
   bound, which a retried send costs at most. *)
let send_telemetry () =
  handle
    box (2, 6) (Receipt "telemetry") as slot in
    perform Send "telemetry";
    unbox slot as r in
    r
  with send_retry

(* Correctly accepted by the typechecker: a non-exact bound on both sides ---
   the lower bound demands only the first transmission before the receipt may
   be read, and the upper bound allows either two transmissions or six ticks of
   waiting. *)
let send_by_events () =
  box ({Tx}, {Tx; Tx | 6}) (Receipt "telemetry") as slot in
  perform Send "telemetry";
  unbox slot as r in
  r

(* Correctly rejected by the typechecker: the order of the events is part of
   both sides of the pair, and this clause sends the model to the cooler before
   it has been through the extruder. The types alone no longer allow a print to
   be run backwards, so only the grade can catch this:

     Typing error: Comparing resource inequality
       ({Heat; Cool; Extrude},{Heat; Cool; Extrude})
       <= ({Heat; Extrude; Cool},{Heat; Extrude; Cool}) failed
*)
(*
let early_cooler =
  handler
  | x -> x
  | PrintModel m k ->
      let h = perform Heat m in
      perform Cool (box 2 (Extruded h));
      perform Extrude h;
      continue k with (box (2, 8) (Reheated h))
*)

(* Correctly rejected by the typechecker: neither run of 'Print' begins with a
   'Cool', and the order of a bound is not negotiable, however the model that
   is handed to the cooler came to be:

     Typing error: Comparing resource inequality
       ({Cool; Heat},{Cool; Heat})
       <= ({Heat; Cool | Heat; Extrude; Cool},
           {Heat; Cool | Heat; Extrude; Cool}) failed
*)
(*
let twisted_printer =
  handler
  | x -> x
  | Print m k ->
      perform Cool (box 2 (Extruded (Heated m)));
      let h = perform Heat m in
      continue k with (box (2, 8) (Reheated h))
*)

(* Correctly rejected by the typechecker on the lower bound, which demands the
   whole run it promises: a clause that stops after the extrusion covers
   neither run of 'Print', even though the upper bound of 'Print' would
   happily allow it:

     Typing error: Comparing resource inequality
       ({Heat; Extrude},{Heat; Extrude})
       <= ({Heat; Cool | Heat; Extrude; Cool},
           {Heat; Cool | Heat; Extrude; Cool}) failed
*)
(*
let sloppy_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      perform Extrude h;
      continue k with (box (2, 8) (Reheated h))
*)

(* Correctly rejected by the typechecker, and the reason the mixing has to be a
   default implementation rather than a handler: an operation case is checked
   against the grade of the operation, and a delay never realises the event
   '{MixEpoxy}' --- only performing 'MixEpoxy' itself would, which is circular.
   A default is checked against the 'within (1, 1)' bounds instead, which the
   very same tick of mixing meets exactly:

     Typing error: Comparing resource inequality
       ({1},{1}) <= ({MixEpoxy},{MixEpoxy}) failed
*)
(*
let mixer =
  handler
  | x -> x
  | MixEpoxy () k -> delay 1; continue k with (box (8, 11) Epoxy)
*)

(* Correctly rejected by the typechecker: the epoxy is mixed after the print
   instead of before it, so only the two ticks of the closing rest are banked
   towards the eight it needs to set:

     Typing error: Comparing resource inequality ({2},{2}) <= ({8},{11}) failed
*)
(*
let print_sword_lazy () =
  handle
    let printed = perform PrintModel (Model "Sword") in
    let glue = perform MixEpoxy () in
    delay 2;
    unbox printed as p in
    unbox glue as g in
    perform Mount (p, g)
  with printer
*)

(* Correctly rejected by the typechecker: the print is left to rest for five
   ticks instead of two, which its own '[(2, 8)]' box still allows, but by then
   the epoxy may have hardened, since 2 + 5 + 2 + 5 = 14 is past its pot life
   of eleven:

     Typing error: Comparing resource inequality
       ({Heat; Extrude; Cool; 5},{Heat; Extrude; Cool; 5})
       <= ({8},{11}) failed
*)
(*
let print_sword_impatient () =
  handle
    let glue = perform MixEpoxy () in
    let printed = perform PrintModel (Model "Sword") in
    delay 5;
    unbox printed as p in
    unbox glue as g in
    perform Mount (p, g)
  with printer
*)

(* Correctly rejected by the typechecker: the glue is unboxed after the rest,
   exactly as in 'print_sword', but then a tick passes before the mounting ---
   and mixed epoxy does not keep, since 'epoxy' is declared 'noneternal', so
   the unboxed glue does not survive that tick:

     Typing error: Type epoxy is not eternal and resource inequality
       ({1},{1}) <= ({0},{0}) failed
*)
(*
let print_sword_hasty () =
  handle
    let glue = perform MixEpoxy () in
    let printed = perform PrintModel (Model "Sword") in
    delay 2;
    unbox printed as p in
    unbox glue as g in
    delay 1;
    perform Mount (p, g)
  with printer
*)

(* Correctly rejected by the typechecker: a tick of dawdling between the heater
   and the extruder, and the quick epoxy may have hardened by the time it is
   reached, since 2 + 1 + 5 = 8 is past the seven ticks of its pot life:

     Typing error: Comparing resource inequality
       ({Heat; 1; Extrude},{Heat; 1; Extrude})
       <= ({3},{7}) failed
*)
(*
