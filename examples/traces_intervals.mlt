  let h = perform Heat (Model "Cog") in
  let p = perform Extrude h in
  let glue = perform MixQuickEpoxy () in
  unbox glue as g in
  let c = perform Cool p in
  perform Mount (Fresh c, g)
*)

(* Correctly rejected by the typechecker: the upper bound of 'Send' allows at
   most two transmissions, so a clause that retries twice does not fit:

     Typing error: Comparing resource inequality
       ({Tx; Tx; Tx},{Tx; Tx; Tx})
       <= ({Tx | Tx; Tx},{Tx | Tx; Tx}) failed
*)
(*
let send_thrice =
  handler
  | x -> x
  | Send msg k ->
      perform Tx msg;
      perform Tx msg;
      perform Tx msg;
      continue k with ()
*)

(* Correctly rejected by the typechecker: the upper bound of 'Send' contains no
   delays, so there is no allowance left to pay for a tick of waiting, even
   though the lower bound would be happy with it:

     Typing error: Comparing resource inequality
       ({Tx; 1},{Tx; 1})
       <= ({Tx | Tx; Tx},{Tx | Tx; Tx}) failed
*)
(*
let send_lazy =
  handler
  | x -> x
  | Send msg k -> perform Tx msg; delay 1; continue k with ()
*)

(* Correctly rejected by the typechecker: the session expires after five
   ticks, which does not pay for a retried send, which costs 3 + 3:

     Typing error: Comparing resource inequality
       ({Tx | Tx; Tx},{Tx | Tx; Tx})
       <= ({2},{5}) failed
*)
(*
let send_telemetry_impatient () =
  handle
    box (2, 5) (Receipt "telemetry") as slot in
    perform Send "telemetry";
    unbox slot as r in
    r
  with send_retry
*)

(* Correctly rejected by the typechecker: the receipt is not ready after four
   ticks if the send consists of a single transmission, which banks only two:

     Typing error: Comparing resource inequality
       ({Tx | Tx; Tx},{Tx | Tx; Tx})
       <= ({4},{6}) failed
*)
(*
let send_telemetry_lazy () =
  handle
    box (4, 6) (Receipt "telemetry") as slot in
    perform Send "telemetry";
    unbox slot as r in
    r
  with send_retry
*)

(* 'printer' handles 'PrintModel'; the atomic 'MixEpoxy', 'Heat', 'Extrude',
   'Cool' and 'Mount' reach the top level and run their defaults, so the run
   completes with the sword mounted on its base. *)
run print_sword ()
