(* Run this example with the 'time-lower-bound' grading monoid, e.g.

     ./cli.exe --resources time-lower-bound examples/3dprint_handlers.mlt *)

(* The stages a printed model goes through, from the model file to a
   finished print. *)
type model = Model of string
type fresh = Fresh of model
type cooled = Cooled of fresh
type uvCured = UvCured of cooled
type complete = Complete of uvCured

(* Printing takes seven ticks, and the print it returns has to cool for five
   before it may be touched. *)
operation PrintResinModel : model ~> [5]fresh # 7
(* Curing a cooled print takes five ticks. *)
operation UvCure : cooled ~> uvCured # 5

(* Correctly accepted by the typechecker: each clause delays exactly the grade
   of the operation it handles and then continues, so each clause grade is that
   of the operation composed with that of the continuation. *)
let h = 
  handler
  | x -> x
  | PrintResinModel model k ->
      delay 7;
      continue k with (box 5 (Fresh model))
  | UvCure cooled k ->
      delay 5;
      continue k with (UvCured cooled)

(* Correctly accepted by the typechecker: printing the hammer banks the seven
   ticks the sword's '[5]' box demands, and curing the sword banks the five the
   hammer's box demands. *)
run
  handle
    let freshSword = perform PrintResinModel (Model "Sword") in
    let freshHammer = perform PrintResinModel (Model "Hammer") in
    unbox freshSword as cooledSword in 
    let curedSword = perform UvCure (Cooled cooledSword) in
    unbox freshHammer as cooledHammer in
    let curedHammer = perform UvCure (Cooled cooledHammer) in
    (Complete curedSword, Complete curedHammer)
  with h