(* Run this example with the 'timed-traces-upper-bound' grading monoid, e.g.

     ./cli.exe --resources timed-traces-upper-bound examples/timed_traces_upper.mlt *)

type model = Model of string
type heated = Heated of model
type extruded = Extruded of heated
type cooled = Cooled of extruded
type fresh = Fresh of cooled | Reheated of heated
type epoxy = Epoxy
type mounted = Mounted of fresh * epoxy
type receipt = Receipt of string

(* The heater warms a model up, so that it can be extruded. *)
operation Heat : model ~> heated # {Heat} within (1, 2)
default Heat m = delay 1; Heated m

(* A freshly extruded model is still hot: it goes to the cooler, which must
   collect it within two ticks. *)
operation Extrude : heated ~> [2] extruded # {Extrude} within (3, 5)
default Extrude h = delay 3; box 2 (Extruded h)

(* The cooler takes the hot extruded model and cools it down to something that
   can be handled. *)
operation Cool : [2] extruded ~> cooled # {Cool} within (2, 2)
default Cool p = delay 2; unbox p as e in Cooled e

(* A print is the three steps, in that order, and the finished print must be
   collected within eight ticks. *)
operation PrintModel : model ~> [8] fresh # {Heat; Extrude; Cool} within (6, 9)

(* A print job either extrudes a fresh model or is a quick reheat. *)
operation Print : model ~> [8] fresh
  # {Heat; Extrude; Cool | Heat; Cool}
  within (3, 9)

(* A single transmission of a message. *)
operation Tx : string ~> unit # {Tx} within (2, 3)
default Tx msg = delay 2

(* A send is one or two transmissions. *)
operation Send : string ~> unit # {Tx | Tx; Tx} within (2, 6)

(* Correctly accepted by the typechecker: the clause performs exactly the three
   steps 'PrintModel' promises, in the promised order. *)
let printer =
  handler
  | x -> x
  | PrintModel m k ->
      let h = perform Heat m in
      let p = perform Extrude h in
      let c = perform Cool p in
      continue k with (box 8 (Fresh c))

(* Correctly accepted by the typechecker by sub-effecting: a clause may also
   forward the operation it handles, since '{Heat}' fits inside '{Heat}'
   composed with the grade of the continuation. *)
let forward =
  handler
  | x -> x
  | Heat m k -> let h = perform Heat m in continue k with h

(* Correctly accepted by the typechecker: the closing wait collects the print,
   well inside the eight ticks its '[8]' box allows. The epoxy must be used
   within eleven ticks, which pays for the slowest run of a whole 'PrintModel'
   and the rest that follows it, because 2 + 5 + 2 + 2 = 11. *)
let print_sword () =
  handle
    box 11 Epoxy as glue in
    let printed = perform PrintModel (Model "Sword") in
    delay 2;
    unbox printed as p in
    unbox glue as g in
    Mounted (p, g)
  with printer

(* Correctly accepted by the typechecker: the same bound on the epoxy spelled
   out as the events of the job, the closing rest included, and realised by
   performing the three steps by hand. *)
let print_cog () =
  box {Heat; Extrude; Cool; 2} Epoxy as glue in
  let h = perform Heat (Model "Cog") in
  let p = perform Extrude h in
  let c = perform Cool p in
  delay 2;
  unbox glue as g in
  Mounted (Fresh c, g)

(* Correctly accepted by the typechecker: the clause realises the first of the
   two alternatives 'Print' allows. *)
let full_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      let p = perform Extrude h in
      let c = perform Cool p in
      continue k with (box 8 (Fresh c))

(* Correctly accepted by the typechecker: the clause realises the other
   alternative, a reheat that skips the extrusion --- the model was extruded in
   an earlier job, so it goes straight from the heater to the cooler. *)
let quick_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      perform Cool (box 2 (Extruded h));
      continue k with (box 8 (Reheated h))

(* Correctly accepted by the typechecker, which may be surprising: an upper
   bound only forbids doing more than it allows, never doing less, so this
   clause fits inside the first alternative of 'Print' by leaving its 'Cool'
   unspent. Skipping the cooling does mean it has no cooled model to hand back,
   only the reheated one. *)
let sloppy_printer =
  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      perform Extrude h;
      continue k with (box 8 (Reheated h))

(* Correctly accepted by the typechecker: the clause performs one transmission,
   which fits inside either alternative of 'Send'. *)
let send_once =
  handler
  | x -> x
  | Send msg k -> perform Tx msg; continue k with ()

(* Correctly accepted by the typechecker: the clause retries once, which fits
   inside the two-transmission alternative of 'Send'. *)
let send_retry =
  handler
  | x -> x
  | Send msg k -> perform Tx msg; perform Tx msg; continue k with ()

(* Correctly accepted by the typechecker: the receipt must be collected within
   six ticks, which pays for the costlier alternative of 'Send', because
   3 + 3 = 6. *)
let send_telemetry () =
  handle
    box 6 (Receipt "telemetry") as slot in
    perform Send "telemetry";
    unbox slot as r in
    r
  with send_retry

(* Correctly accepted by the typechecker: a strict super-grade of what the send
   costs, spelled out as events instead of ticks --- each alternative of 'Send'
   fits inside one of the two runs the receipt allows. *)
let send_by_events () =
  box {Tx; Tx | 10} (Receipt "telemetry") as slot in
  perform Send "telemetry";
  unbox slot as r in
  r

(* Correctly accepted by the typechecker: a single transmission also fits inside
   a bound of two, since the second 'Tx' of the bound may go unspent. *)
let send_by_two () =
  box {Tx; Tx} (Receipt "telemetry") as slot in
  perform Send "telemetry";
  unbox slot as r in
  r

(* Correctly rejected by the typechecker: the order of the events is part of the
   bound, and this clause sends the model to the cooler before it has been
   through the extruder. The types alone no longer allow a print to be run
   backwards, so only the grade can catch this:

     Typing error: Comparing resource inequality {Heat; Cool; Extrude}
       <= {Heat; Extrude; Cool} failed
*)
(*
let early_cooler =
  handler
  | x -> x
  | PrintModel m k ->
      let h = perform Heat m in
      perform Cool (box 2 (Extruded h));
      perform Extrude h;
      continue k with (box 8 (Reheated h))
*)

(* Correctly rejected by the typechecker: neither alternative of 'Print' begins
   with a 'Cool', and the order of a bound is not negotiable, however the model
   that is handed to the cooler came to be:

     Typing error: Comparing resource inequality {Cool; Heat}
       <= {Heat; Cool | Heat; Extrude; Cool} failed
*)
(*
let twisted_printer =
  handler
  | x -> x
  | Print m k ->
      perform Cool (box 2 (Extruded (Heated m)));
      let h = perform Heat m in
      continue k with (box 8 (Reheated h))
*)

(* Correctly rejected by the typechecker: the epoxy hardens after ten ticks,
   which does not buy the slowest print plus the rest, which may take eleven:

     Typing error: Comparing resource inequality {Heat; Extrude; Cool; 2}
       <= {10} failed
*)
(*
let print_sword_cheap () =
  handle
    box 10 Epoxy as glue in
    let printed = perform PrintModel (Model "Sword") in
    delay 2;
    unbox printed as p in
    unbox glue as g in
    Mounted (p, g)
  with printer
*)

(* Correctly rejected by the typechecker: 'Send' allows at most two
   transmissions, so a clause that retries twice does not fit:

     Typing error: Comparing resource inequality {Tx; Tx; Tx}
       <= {Tx | Tx; Tx} failed
*)
(*
let send_thrice =
  handler
  | x -> x
  | Send msg k ->
      perform Tx msg;
      perform Tx msg;
      perform Tx msg;
      continue k with ()
*)

(* Correctly rejected by the typechecker: the alternatives of 'Send' contain no
   delays, so there is no allowance left to pay for a tick of waiting:

     Typing error: Comparing resource inequality {Tx; 1} <= {Tx | Tx; Tx} failed
*)
(*
let send_lazy =
  handler
  | x -> x
  | Send msg k -> perform Tx msg; delay 1; continue k with ()
*)

(* Correctly rejected by the typechecker: the session expires after five
   ticks, which does not pay for the two-transmission alternative of 'Send',
   which costs 3 + 3:

     Typing error: Comparing resource inequality {Tx | Tx; Tx} <= {5} failed
*)
(*
let send_telemetry_cheap () =
  handle
    box 5 (Receipt "telemetry") as slot in
    perform Send "telemetry";
    unbox slot as r in
    r
  with send_retry
*)

(* Correctly rejected by the typechecker: a bound of one transmission is a
   strict sub-grade of what 'Send' may exhibit, since it may transmit twice:

     Typing error: Comparing resource inequality {Tx | Tx; Tx} <= {Tx} failed
*)
(*
let send_by_one () =
  box {Tx} (Receipt "telemetry") as slot in
  perform Send "telemetry";
  unbox slot as r in
  r
*)

(* The single run below handles the 'Send' with 'send_retry', which replaces it
   by two transmissions. Those are atomic, and the default given for 'Tx' above
   says what they mean, so the run completes and returns the delivery
   receipt. *)
run send_telemetry ()
