(* Run this example with the 'time-lower-bound' grading monoid, e.g.

     ./temporal-millet --resources time-lower-bound examples/handlers_nested_reject.mlt *)

operation Op1 : unit ~> unit # 2
operation Op2 : unit ~> unit # 3

(* Correctly rejected by the typechecker: 'examples/handlers_nested.mlt' with
   one mistake, the inner case never resuming 'k'', so its grade is the 3
   ticks it delays alone and misses the inner continuation's. *)
let h =
  handler
  | x -> x
  | Op1 p k ->
      let a =
        handle
          perform Op2 ();
          return ()
        with
          (handler
           | y -> y
           | Op2 q k' ->
               delay 3;
               return ())      (* <- k' is never resumed *)
      in
      continue k with ()

run
  handle
    perform Op1 ();
    return 7
  with h
