(* Run this example with the 'time-lower-bound' grading monoid, e.g.

     ./temporal-millet --resources time-lower-bound examples/handlers_nested_reject.mlt *)

operation Op1 : unit ~> unit # 2
operation Op2 : unit ~> unit # 3

(* Correctly rejected by the typechecker: 'examples/handlers_nested.mlt' with
   one mistake, the inner case never resuming 'k'', so its grade is the outer
   continuation's alone and misses the inner one's. *)
let h =
  handler
  | x -> x
  | Op1 p k ->
      handle
        perform Op2 ();
        continue k with ()
      with
        (handler
         | y -> y
         | Op2 q k' ->
             continue k with ())      (* <- k' is never resumed *)

run
  handle
    perform Op1 ();
    return 7
  with h
