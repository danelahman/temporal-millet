(* Run this example with the 'time-lower-bound' grading monoid, e.g.

     ./temporal-millet --resources time-lower-bound examples/handlers_nested.mlt *)

(* An operation case is checked for every grade its continuation may have, so
   two nested cases quantify over two such grades: ρ₀ for the outer 'k' and ρ₁
   for the inner 'k''. A case may only resume its own continuation: the outer
   'k' is bound outside the inner case, whose context keeps nothing but
   eternal types, and a continuation is a box, which is never eternal. *)

operation Op1 : unit ~> unit # 2
operation Op2 : unit ~> unit # 3

(* Correctly accepted by the typechecker: the inner case delays the 3 ticks of
   'Op2' and resumes 'k'', so its grade 3 + ρ₁ is a sub-grade of 3 + ρ₁; the
   outer case resumes 'k' once the inner handle is done. *)
let h =
  handler
  | x -> x
  | Op1 p k ->
      let a =
        handle
          perform Op2 ();
          return ()
        with
          (handler
           | y -> y
           | Op2 q k' ->
               delay 3;
               continue k' with ())
      in
      continue k with ()

(* The run performs 'Op1', whose case performs 'Op2'; the outer case's grade
   3 + ρ₀ covers the 2 ticks of 'Op1', and the run returns 7. *)
run
  handle
    perform Op1 ();
    return 7
  with h
