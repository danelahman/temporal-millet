(* Run this example with the 'time-upper-bound' grading monoid, e.g.

     ./temporal-millet --resources time-upper-bound examples/handlers_upper_bound.mlt *)

(* Under 'time-upper-bound' a grade rho is an upper bound on the ticks a
   computation takes, rho is a sub-grade of rho' when rho <= rho', and zero
   is the minimum grade. A 'Get' clause's continuation k : [71](int -> ... #
   rho) may be resumed at any time up to 71 ticks after the call, and its
   grade rho is arbitrary. *)

(* Reading the state takes at most 71 ticks. *)
operation Get : unit ~> int # 71
(* Writing it takes at most 2. *)
operation Set : int ~> unit # 2

(* Correctly accepted by the typechecker: the 'Get' clause delays exactly the
   71 ticks the operation allows and then resumes. *)
let h =
  handler
  | x -> x
  | Get () k ->
      delay 71;
      continue k with 42

(* Correctly accepted by the typechecker: an upper bound only forbids taking
   more than the operation allows, so a case may take less; delaying only 10
   before resuming is fine, since 10 + rho <= 71 + rho. *)
let h_fast =
  handler
  | x -> x
  | Get () k ->
      delay 10;
      continue k with 42

(* Correctly rejected by the typechecker: 72 ticks overrun the 71 the
   continuation must be resumed within:

     Typing error: The case for `Get` has grade `72`, which does not match
       the grade `71` of `Get` followed by its continuation
       Note: the resource inequality `72 <= 71` does not hold
*)
(*
let h_slow =
  handler
  | x -> x
  | Get () k ->
      delay 72;
      continue k with 42
*)

(* Correctly accepted by the typechecker: never resuming gives the case
   grade 0, a sub-grade of 71 + rho for every rho, since zero is the minimum
   grade. Under a lower bound the same handler is rejected. *)
let h_abandon =
  handler
  | x -> x
  | Get () k -> 0

(* Correctly rejected by the typechecker: resuming twice takes rho + rho, but
   the clause may promise only 71 + rho, i.e. rho <= 71, which fails already
   for rho = 72:

     Typing error: For every grade `ρ₀` the continuation `k` may have, the
       case for `Get` must have a grade matching `71 + ρ₀`, but its grade
       `ρ₀ + ρ₀` does not
       Note: the resource inequality `∀ρ₀. ρ₀ <= 71` does not hold: for
         `ρ₀ = 72` it becomes `72 <= 71`
   (Contrast: accepted under a lower bound.)
*)
(*
let h_twice =
  handler
  | x -> x
  | Get () k ->
      let y = continue k with 42 in
      continue k with y
*)

(* Correctly accepted by the typechecker: the local function 'f' is used
   before resuming, so only its eternal result 'z' is kept across the
   resumption. *)
let h_before =
  handler
  | x -> x
  | Get () k ->
      let f = (fun () -> 1) in
      let z = f () in
      let y = continue k with 42 in
      z + y

(* Correctly rejected by the typechecker: 'f' is not eternal, so it may not
   be used after a resumption that may take any number of ticks:

     Typing error: Variable `f` is used after grade `ρ₀` has elapsed, but
       its type `unit → int` is not eternal
       Note: for every grade `ρ₀` the continuation `k` may have, the resource
         inequality `∀ρ₀. ρ₀ <= 0` must hold, but does not: for `ρ₀ = 1`
         it becomes `1 <= 0`
*)
(*
let h_after =
  handler
  | x -> x
  | Get () k ->
      let f = (fun () -> 1) in
      let y = continue k with 42 in
      f () + y
*)

(* Correctly rejected by the typechecker: the continuation's arbitrary grade
   would escape into the type of 'h_leak' through 'g', where a caller could
   pick it:

     Typing error: The type `([71](int → α # ρ₀) → β # ρ₁) → α # ρ₂ ⇒ α # 0`
       of `h_leak` mentions `ρ₀`, the grade of the continuation `k` in the
       case for `Get`, which may be any grade and so cannot occur in it
*)
(*
let h_leak g =
  handler
  | x -> x
  | Get () k ->
      g k;
      continue k with 42
*)

(* The run handles a 'Get' with 'h_fast', which delays only 10 of the 71
   allotted ticks before resuming with 42, so the run returns 45. *)
run
  handle
    let x = perform Get () in
    return x + 3
  with h_fast

(* The run handles a 'Get' with 'h_abandon', which never resumes, so the run
   returns 0 without ever reaching the '+ 3'. *)
run
  handle
    let x = perform Get () in
    return x + 3
  with h_abandon

(* The run handles a 'Get' with 'h_before', whose case computes 'z' before
   resuming with 42 and adds it to the result afterwards, so the run returns
   46. *)
run
  handle
    let x = perform Get () in
    return x + 3
  with h_before
