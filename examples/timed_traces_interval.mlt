    box (8, 10) Epoxy as glue in
    let printed = perform PrintModel (Model "Sword") in
    delay 2;
    unbox printed as p in
    unbox glue as g in
    perform Mount (p, g)
  with printer
*)

(* Correctly rejected by the typechecker: a quicker-setting epoxy, ready after
   the six ticks the print banks, is unboxed the moment the print is done ---
   but mixed epoxy does not keep, since 'epoxy' is declared 'noneternal', so it
   does not survive the two ticks of rest before the mounting:

     Typing error: Type epoxy is not eternal and resource inequality
       ({2},{2}) <= ({0},{0}) failed
*)
(*
