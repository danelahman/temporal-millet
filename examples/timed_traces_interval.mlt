  handler
  | x -> x
  | Send msg k ->
      perform Tx msg;
      perform Tx msg;
      perform Tx msg;
      continue k with ()
*)

(* Correctly rejected by the typechecker: the upper bound of 'Send' contains no
   delays, so there is no allowance left to pay for a tick of waiting, even
   though the lower bound would be happy with it:

     Typing error: Comparing resource inequality
       ({Tx; 1},{Tx; 1})
       <= ({Tx | Tx; Tx},{Tx | Tx; Tx}) failed
*)
(*
let send_lazy =
  handler
  | x -> x
  | Send msg k -> perform Tx msg; delay 1; continue k with ()
*)

(* Correctly rejected by the typechecker: the session expires after five
   ticks, which does not pay for a retried send, which costs 3 + 3:

     Typing error: Comparing resource inequality
       ({Tx | Tx; Tx},{Tx | Tx; Tx})
       <= ({2},{5}) failed
*)
(*
