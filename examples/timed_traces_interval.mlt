    box (2, 5) (Receipt "telemetry") as slot in
    perform Send "telemetry";
    unbox slot as r in
    r
  with send_retry
*)

(* Correctly rejected by the typechecker: the receipt is not ready after four
   ticks if the send consists of a single transmission, which banks only two:

     Typing error: Comparing resource inequality
       ({Tx | Tx; Tx},{Tx | Tx; Tx})
       <= ({4},{6}) failed
*)
(*
let send_telemetry_lazy () =
  handle
    box (4, 6) (Receipt "telemetry") as slot in
    perform Send "telemetry";
    unbox slot as r in
    r
  with send_retry
*)

(* The single run below handles the 'PrintModel' with 'printer', which replaces
   it by the three steps of a print. Those are atomic, and so is the closing
   'Mount', which no handler catches; the defaults given for them above say what
   they mean, so the run completes and returns the printed sword mounted on its
   base, the glue used up. *)
run print_sword ()
