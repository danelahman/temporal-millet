    perform Mount (p, g)
  with printer
*)

(* Correctly rejected by the typechecker: the epoxy hardens after six ticks,
   while heating and extruding may take up to seven:

     Typing error: Comparing resource inequality
       ({Heat; Extrude},{Heat; Extrude})
       <= ({3},{6}) failed
*)
(*
