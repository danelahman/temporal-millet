  handler
  | x -> x
  | Print m k ->
      let h = perform Heat m in
      perform Extrude h;
      continue k with (box (2, 8) (Reheated h))
*)

(* Correctly rejected by the typechecker: the epoxy needs nine ticks to set,
   which the print and the rest that follows it do not bank, since
   1 + 3 + 2 + 2 = 8:

     Typing error: Comparing resource inequality
       ({Heat; Extrude; Cool; 2},{Heat; Extrude; Cool; 2})
       <= ({9},{11}) failed
*)
(*
