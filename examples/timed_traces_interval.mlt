    unbox glue as g in
    perform Mount (p, g)
  with printer
*)

(* Correctly rejected by the typechecker: the epoxy has hardened after ten
   ticks, and the slowest print plus the rest takes 2 + 5 + 2 + 2 = 11:

     Typing error: Comparing resource inequality
       ({Heat; Extrude; Cool; 2},{Heat; Extrude; Cool; 2})
       <= ({8},{10}) failed
*)
(*
